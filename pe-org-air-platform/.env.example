# =========================
# Application
# =========================
APP_NAME=pe-orgair
APP_ENV=development
DEBUG=true
PORT=8000
SECRET_KEY=change-this-secret-key

# =========================
# Snowflake Configuration
# =========================
SNOWFLAKE_ACCOUNT=NEFKJCS-QAC18212
SNOWFLAKE_USER=
# Password auth — only used if SNOWFLAKE_PRIVATE_KEY is not set. Blocked by
# account MFA enforcement for service accounts; prefer key-pair auth below.
SNOWFLAKE_PASSWORD=
# Key-pair auth (required once MFA is enforced on the account). Paste the full
# PEM contents of the PKCS#8 private key here (keep the BEGIN/END lines), e.g.
# generated via:
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out sf_private_key.p8 -nocrypt
# Then register the matching public key in Snowflake:
#   ALTER USER <SNOWFLAKE_USER> SET RSA_PUBLIC_KEY='<contents of sf_public_key.pub, no header/footer>';
SNOWFLAKE_PRIVATE_KEY=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=PE_ORGAIR_WH
SNOWFLAKE_DATABASE=PE_ORGAIR_DB
SNOWFLAKE_SCHEMA=PLATFORM

# =========================
# AWS S3
# =========================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=pe-orgair-platform-group5

# =========================
# Redis
# =========================
REDIS_URL=redis://localhost:6379/0

# =========================
# Streamlit / FastAPI URL
# =========================
# Used by Streamlit clients to talk to the local FastAPI server.
API_BASE_URL=http://localhost:8000
FASTAPI_URL=http://localhost:8000

# =========================
# SEC EDGAR
# =========================
SEC_COMPANY_NAME=PE-OrgAIR-Platform
SEC_EMAIL=

# =========================
# PatentsView API
# =========================
PATENTSVIEW_API_URL=https://search.patentsview.org/api/v1/patent/
PATENTSVIEW_API_KEY=

# =========================
# BuiltWith API
# =========================
BUILTWITH_API_KEY=

# =========================
# RapidAPI
# =========================
RAPIDAPI_KEY=
JSEARCH_API_KEY=
# =========================
# LLM / AI APIs
# =========================
GROQ_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# =========================
# Chroma Cloud Vector DB
# =========================
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=pe_org-air-platform
CHROMA_HOST=api.trychroma.com

# =========================
# Airflow
# =========================
AIRFLOW_FERNET_KEY=
AIRFLOW_ADMIN_PASSWORD=
